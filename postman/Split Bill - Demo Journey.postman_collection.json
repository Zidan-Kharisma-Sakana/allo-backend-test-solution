              "raw": "{\n  \"payerId\": \"{{alice_id}}\",\n  \"amount\": 100000.0,\n  \"description\": \"Lunch for everyone\",\n  \"participantIds\": [\n    \"{{alice_id}}\",\n    \"{{bob_id}}\",\n    \"{{cara_id}}\"\n  ]\n}",
              "options": {
