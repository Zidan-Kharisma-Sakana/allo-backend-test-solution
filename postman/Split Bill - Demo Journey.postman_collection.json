    {
      "name": "05 - Review and settle up",
      "description": "Show the group in the session list, then finish with the settlement visualization.",
      "item": [
        {
          "name": "14 - Find the group in my session",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/bill-groups",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "bill-groups"
              ]
            },
            "description": "This session can see the group created at the start of the walkthrough."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const responseData = pm.response.json();",
                  "",
                  "pm.test(\"Current group is visible\", () => pm.expect(responseData.map(group => group.id)).to.include(pm.collectionVariables.get(\"group_id\")));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "15 - Show the final settlement",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/bill-groups/{{group_id}}/settlement",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "bill-groups",
                "{{group_id}}",
                "settlement"
              ]
            },
            "description": "Finish here. Open Visualization / Visualize to present the balances and transfers.\n\nExpected result with the default username:\n- Total: 135,000.00 IDR.\n- Bob pays Alice 28,333.33 IDR.\n- Cara pays Alice 48,333.33 IDR.\n- Separate service charge: 5%, or 6,750.00 IDR.\n\nThe API suggests transfers; it does not record completed payments."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const responseData = pm.response.json();",
                  "",
                  "pm.test(\"Final total and separate service charge\", () => {",
                  "    pm.expect(responseData.totalExpenses).to.eql(135000);",
                  "    pm.expect(responseData.service_charge_pct).to.eql(5);",
                  "    pm.expect(responseData.service_charge_amount).to.eql(6750);",
                  "});",
                  "pm.test(\"Bob and Cara settle with Alice\", () => {",
                  "    const actual = responseData.settlements.map(payment => [payment.fromParticipantId, payment.toParticipantId, payment.amount]);",
                  "    pm.expect(actual).to.have.deep.members([",
                  "        [pm.collectionVariables.get(\"bob_id\"), pm.collectionVariables.get(\"alice_id\"), 28333.33],",
                  "        [pm.collectionVariables.get(\"cara_id\"), pm.collectionVariables.get(\"alice_id\"), 48333.33]",
                  "    ]);",
                  "});",
                  "const names = Object.fromEntries(responseData.balances.map(person => [person.participantId, person.name]));",
                  "const money = value => Number(value).toLocaleString(\"en-US\", { minimumFractionDigits: 2, maximumFractionDigits: 2 });",
                  "const transfers = responseData.settlements.map(payment => ({ from: names[payment.fromParticipantId], to: names[payment.toParticipantId], amount: money(payment.amount) }));",
                  "const balances = responseData.balances.map(person => ({ name: person.name, paid: money(person.paid), owed: money(person.owed), balance: money(person.balance) }));",
                  "const template = `",
                  "<style>",
                  "body { margin: 0; padding: 32px; background: #f4f6fa; color: #182339; font: 15px -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif; }",
                  "main { max-width: 920px; margin: auto; } h1 { margin: 6px 0 24px; font-size: 30px; } h2 { margin: 28px 0 12px; font-size: 20px; }",
                  ".label { color: #65748b; font-size: 12px; letter-spacing: 1px; text-transform: uppercase; }",
                  ".cards { display: flex; gap: 16px; } .card { background: white; border: 1px solid #dde3ed; border-radius: 12px; padding: 20px; flex: 1; }",
                  ".value { margin-top: 8px; font-size: 26px; font-weight: 650; } .note { color: #65748b; margin: 12px 0 0; line-height: 1.5; }",
                  "table { width: 100%; border-collapse: collapse; background: white; } th, td { padding: 14px 18px; border-bottom: 1px solid #e4e9f1; text-align: left; } th { background: #eaf0f8; } .number { text-align: right; font-variant-numeric: tabular-nums; }",
                  "</style>",
                  "<main>",
                  "<div class=\"label\">Split Bill / Settlement</div><h1>{{groupName}}</h1>",
                  "<div class=\"cards\"><div class=\"card\"><div class=\"label\">Total expenses / {{currency}}</div><div class=\"value\">{{total}}</div></div><div class=\"card\"><div class=\"label\">Separate service charge / {{percentage}}%</div><div class=\"value\">{{charge}}</div><div class=\"note\">Excluded from participant transfers.</div></div></div>",
                  "<h2>Who pays whom</h2><table><tr><th>From</th><th>To</th><th class=\"number\">Amount / {{currency}}</th></tr>{{#each transfers}}<tr><td>{{from}}</td><td>{{to}}</td><td class=\"number\">{{amount}}</td></tr>{{else}}<tr><td colspan=\"3\">Everyone is settled.</td></tr>{{/each}}</table>",
                  "<h2>Participant balances</h2><table><tr><th>Participant</th><th class=\"number\">Paid</th><th class=\"number\">Share owed</th><th class=\"number\">Net balance</th></tr>{{#each balances}}<tr><td>{{name}}</td><td class=\"number\">{{paid}}</td><td class=\"number\">{{owed}}</td><td class=\"number\">{{balance}}</td></tr>{{/each}}</table><p class=\"note\">A positive balance means the participant receives money. A negative balance means they pay.</p>",
                  "</main>`;",
                  "pm.visualizer.set(template, { groupName: pm.collectionVariables.get(\"renamed_group_name\"), currency: responseData.currency, total: money(responseData.totalExpenses), percentage: responseData.service_charge_pct, charge: money(responseData.service_charge_amount), transfers, balances });"
                ]
              }
            }
          ],
