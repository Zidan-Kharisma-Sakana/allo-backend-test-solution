        {
          "name": "send same request together",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "JSESSIONID={{owner_session}}"
              }
            ],
            "url": "{{base_url}}/bill-groups/{{group_id}}/expenses"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const vars = pm.collectionVariables;",
                  "const body = {payerId:vars.get(\"bob_id\"), amount:120, description:\"concurrent retry\", participantIds:[vars.get(\"alice_id\"),vars.get(\"bob_id\"),vars.get(\"cara_id\")]};",
                  "const ids = []; let pending = 6;",
                  "for (let i = 0; i < 6; i++) {",
                  " pm.sendRequest({url:pm.variables.get(\"base_url\") + \"/bill-groups/\" + vars.get(\"group_id\") + \"/expenses\", method:\"POST\", header:{\"Content-Type\":\"application/json\", \"Cookie\":\"JSESSIONID=\" + vars.get(i % 2 ? \"member_session\" : \"owner_session\"), \"Idempotency-Key\":vars.get(\"run_id\") + \"-concurrent\"}, body:{mode:\"raw\",raw:JSON.stringify(body)}}, (err, response) => {",
                  "  pm.test(\"parallel request \" + i, () => { pm.expect(err).to.not.exist; pm.expect(response.code).to.eql(201); });",
                  "  if (!err && response.code === 201) ids.push(response.json().id);",
                  "  if (--pending === 0) {",
                  "   pm.test(\"all 6 returned same expense\", () => {pm.expect(ids).to.have.lengthOf(6);pm.expect(new Set(ids).size).to.eql(1);});",
                  "   if (ids.length) vars.set(\"concurrent_id\", ids[0]);",
                  "  }",
                  " });",
                  "}"
                ]
              }
            }
          ]
        },
