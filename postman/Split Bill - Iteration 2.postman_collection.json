{
  "info": {
    "_postman_id": "df6b9cd7-20a3-4f9b-8247-7583071c1e92",
    "name": "Split Bill - iteration 2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run from 01 to 06. creates a new group each run.\n\nOwner, member and outsider use separate session cookies. Cookie jar is disabled per request, no need to clear cookies by hand. IDs and keys get saved automatically.\n\nFlow: settlement first, another session joins, add expenses, retry same requests, then check outsider access. Folder 04 sends 6 expense requests together.\n\nDefault service charge is 5%. change service_charge_pct if app.github-username is different.\n\nOpen Visualize on the last request for who pays who. Rollback and forced invite collisions need database fault injection, checked separately.\n\nNo accounts or verified payer identity. Anyone joined can record expense as anyone in the group."
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:4110",
      "type": "string"
    },
    {
      "key": "service_charge_pct",
      "value": "5",
      "type": "string"
    },
    {
      "key": "run_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "owner_session",
      "value": "",
      "type": "string"
    },
    {
      "key": "member_session",
      "value": "",
      "type": "string"
    },
    {
      "key": "outsider_session",
      "value": "",
      "type": "string"
    },
    {
      "key": "group_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "invite_code",
      "value": "",
      "type": "string"
    },
    {
      "key": "alice_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "bob_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "cara_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "lunch_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "concurrent_id",
      "value": "",
