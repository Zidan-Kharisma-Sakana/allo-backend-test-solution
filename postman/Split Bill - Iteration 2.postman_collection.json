    }
  ],
  "item": [
    {
      "name": "01 - create group and see empty settlement",
      "item": [
        {
          "name": "create group first",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/bill-groups",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bandung weekend - iteration 2\",\n  \"participants\": [\n    \"Alice\",\n    \"Bob\",\n    \"Cara\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"run_id\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "[\"owner_session\", \"member_session\", \"outsider_session\", \"group_id\", \"invite_code\", \"alice_id\", \"bob_id\", \"cara_id\", \"lunch_id\", \"concurrent_id\"].forEach(k => pm.collectionVariables.unset(k));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const cookie = pm.response.headers.all().find(h => h.key.toLowerCase() === \"set-cookie\" && h.value.startsWith(\"JSESSIONID=\"));",
                  "pm.test(\"session cookie exists\", () => pm.expect(cookie).to.exist);",
                  "if (cookie) pm.collectionVariables.set(\"owner_session\", cookie.value.split(\";\")[0].split(\"=\")[1]);",
                  "const group = pm.response.json();",
                  "pm.collectionVariables.set(\"group_id\", group.id);",
                  "pm.collectionVariables.set(\"invite_code\", group.inviteCode);",
                  "pm.test(\"6 uppercase letters/numbers\", () => pm.expect(group.inviteCode).to.match(/^[A-Z0-9]{6}$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "get participants",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "JSESSIONID={{owner_session}}"
              }
            ],
            "url": "{{base_url}}/bill-groups/{{group_id}}/participants"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const people = pm.response.json();",
                  "[\"alice\", \"bob\", \"cara\"].forEach((name, i) => pm.collectionVariables.set(name + \"_id\", people[i].id));"
                ]
              }
            }
          ]
        },
        {
          "name": "empty group settlement",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "JSESSIONID={{owner_session}}"
              }
            ],
            "url": "{{base_url}}/bill-groups/{{group_id}}/settlement"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const s = pm.response.json();",
                  "pm.test(\"nothing to settle yet\", () => { pm.expect(s.totalExpenses).to.eql(0); pm.expect(s.settlements).to.eql([]); });"
                ]
              }
            }
          ]
        }
      ]
    },
