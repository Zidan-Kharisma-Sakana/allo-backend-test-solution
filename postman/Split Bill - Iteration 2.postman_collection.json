        {
          "name": "check settlement",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "JSESSIONID={{member_session}}"
              }
            ],
            "url": "{{base_url}}/bill-groups/{{group_id}}/settlement"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const s = pm.response.json();",
                  "pm.test(\"total 135000\", () => pm.expect(s.totalExpenses).to.eql(135000));",
                  "pm.test(\"who pays who\", () => {",
                  " const transfers = s.settlements.map(t => t.amount).sort((a,b) => a-b);",
                  " pm.expect(transfers).to.eql([28333.33, 48333.33]);",
                  " s.settlements.forEach(t => pm.expect(t.toParticipantId).to.eql(pm.collectionVariables.get(\"alice_id\")));",
                  "});",
                  "pm.test(\"service charge\", () => {",
                  " pm.expect(s.service_charge_pct).to.eql(Number(pm.collectionVariables.get(\"service_charge_pct\")));",
                  " pm.expect(s.service_charge_amount).to.eql(Math.round(s.totalExpenses * s.service_charge_pct) / 100);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
