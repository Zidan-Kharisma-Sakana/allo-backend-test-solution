    {
      "name": "06 - final result",
      "item": [
        {
          "name": "settlement after concurrent retry",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "JSESSIONID={{owner_session}}"
              }
            ],
            "url": "{{base_url}}/bill-groups/{{group_id}}/settlement"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const s = pm.response.json();",
                  "pm.test(\"total 135120\", () => pm.expect(s.totalExpenses).to.eql(135120));",
                  "pm.test(\"balances sum to zero\", () => pm.expect(Math.round(s.balances.reduce((n,b) => n+b.balance,0)*100)).to.eql(0));",
                  "pm.test(\"all balances settled\", () => {",
                  " const remaining = Object.fromEntries(s.balances.map(b => [b.participantId, Math.round(b.balance*100)]));",
                  " s.settlements.forEach(t => { const cents=Math.round(t.amount*100); remaining[t.fromParticipantId]+=cents;remaining[t.toParticipantId]-=cents; });",
                  " Object.values(remaining).forEach(value => pm.expect(value).to.eql(0));",
                  "});",
                  "pm.visualizer.set(`<style>body{font:16px system-ui;padding:24px;color:#172554}table{border-collapse:collapse;width:100%}td,th{text-align:left;padding:12px;border-bottom:1px solid #ddd}h1{font-size:28px}</style><h1>who pays who</h1><p>Total: {{total}} IDR \u00b7 service charge: {{charge}}</p><table><tr><th>from</th><th>to</th><th>amount</th></tr>{{#each transfers}}<tr><td>{{from}}</td><td>{{to}}</td><td>{{amount}}</td></tr>{{/each}}</table>`, {total:s.totalExpenses,charge:s.service_charge_amount,transfers:s.settlements.map(t=>({from:s.balances.find(b=>b.participantId===t.fromParticipantId).name,to:s.balances.find(b=>b.participantId===t.toParticipantId).name,amount:t.amount}))});"
                ]
              }
