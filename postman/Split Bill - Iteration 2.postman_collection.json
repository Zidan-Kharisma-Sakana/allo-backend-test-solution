            }
          ]
        },
        {
          "name": "group shows in member list",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "JSESSIONID={{member_session}}"
              }
            ],
            "url": "{{base_url}}/bill-groups"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"joined group listed\", () => pm.expect(pm.response.json().map(g => g.id)).to.include(pm.collectionVariables.get(\"group_id\")));"
                ]
              }
            }
          ]
        }
      ]
    },
